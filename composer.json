{
    "name": "voltstack/tailwind-vite",
    "description": "The tailwind Vite Package for VoltStack Framework",
    "license": "MIT",
    "keywords": [
        "voltstack",
        "tailwind",
        "vite",
        "php"
    ],
    "authors": [
        {
            "name": "Francisco J. Morales",
            "email": "francisco.morales@voltstack.net"
        }
    ],
    "homepage": "https://voltstack.net",
    "require": {
        "php": "^8.3",
        "voltstack/framework": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../voltstack-framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "VoltStack\\TailwindVite\\": "src"
        },
        "files": [
            "src/Helpers/tailwind_vite.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VoltStack\\TailwindVite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
